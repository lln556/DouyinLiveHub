# ============================================
# 抖音直播监控平台 - 环境变量配置
# ============================================
# 说明：复制此文件为 .env 并填写实际配置
# Docker 部署：docker-compose up -d

# ============================================
# Docker Compose 配置
# ============================================
# 应用端口（Docker 映射到宿主机的端口）
APP_PORT=7654

# Docker 构建镜像源
# 如果 Docker Hub 访问超时，可改成可访问的镜像仓库或本机已有镜像，例如:
# DOCKER_PYTHON_IMAGE=python:3.12-slim
DOCKER_PYTHON_IMAGE=python:3.11-slim
DOCKER_UV_IMAGE=ghcr.io/astral-sh/uv:latest

# MySQL 配置（仅 Docker Compose 使用）
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=douyin_live
MYSQL_USER=douyin
MYSQL_PASSWORD=douyin123
MYSQL_PORT=3306

# ============================================
# 数据库配置
# ============================================
# MySQL 数据库连接字符串
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名
# 本地开发：
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/douyin_live
# Docker 环境会自动覆盖此配置，无需修改

# ============================================
# Flask 配置
# ============================================
# Flask 密钥（用于 session 加密，请修改为随机字符串）
SECRET_KEY=your-secret-key-change-in-production

# 调试模式（生产环境请设为 False）
DEBUG=False

# 是否输出 SQLAlchemy SQL 语句日志（仅排查数据库问题时设为 True）
SQLALCHEMY_ECHO=False

# 登录保护（同时配置账号和密码后启用）
AUTH_USERNAME=admin
AUTH_PASSWORD=change-this-password

# ============================================
# 代理配置
# ============================================
# 是否启用代理
PROXY_ENABLED=False

# 代理类型（http 或 socks5）
PROXY_TYPE=http

# 代理主机
# 本地开发: 127.0.0.1
# Docker 环境访问宿主机代理: host.docker.internal
PROXY_HOST=127.0.0.1

# 代理端口
PROXY_PORT=7890

# ============================================
# Socket.IO 配置
# ============================================
# 允许的跨域来源（* 表示允许所有来源）
SOCKETIO_CORS_ALLOWED_ORIGINS=*

# 是否启用 Socket.IO 日志
SOCKETIO_LOGGER=False

# 是否启用 Engine.IO 日志
SOCKETIO_ENGINEIO_LOGGER=False

# Socket.IO 运行模式。默认 threading，避免 gevent 与普通监控线程混用导致页面请求卡住
SOCKETIO_ASYNC_MODE=threading

# ============================================
# 监控配置
# ============================================
# 监控重连间隔（秒）
MONITOR_RECONNECT_INTERVAL=30

# 最大重试次数
MONITOR_MAX_RETRIES=5

# 重连延迟（秒）
MONITOR_RECONNECT_DELAY=30

# 轮询直播状态间隔（秒）
MONITOR_STATUS_POLL_INTERVAL=90

# 终端状态面板输出。留空表示 Docker 默认关闭、本地默认开启；显式 True/False 可覆盖。
STATUS_DISPLAY_ENABLED=

# ============================================
# 防风控配置
# ============================================
# 是否启用防风控机制
ANTI_DETECTION_ENABLED=True

# 线程启动间隔（秒）
# 多个房间启动时，每个房间启动之间的延迟时间
ANTI_DETECTION_THREAD_START_INTERVAL=3

# 排队读取网址时间（秒）
# HTTP请求获取房间状态前的延迟时间
ANTI_DETECTION_QUEUE_READ_DELAY=2

# 启用检测周期抖动
# 对固定间隔应用随机抖动，模拟真实用户行为
ANTI_DETECTION_JITTER_ENABLED=True

# 抖动范围（+/-秒）
# 实际间隔 = 基础间隔 +/- 随机值(0-此范围)
ANTI_DETECTION_JITTER_RANGE=5

# ============================================
# 抖音登录 Cookie 配置
# ============================================
# 可选。2026-05 起，游客身份可能收不到礼物推送。
# 如需礼物消息，请登录 https://live.douyin.com/ 后在浏览器开发者工具 Network/Fetch 请求中复制完整 Cookie。
# 注意：真实账号 Cookie 同时监听过多直播间可能触发风控，请妥善保管，不要提交到代码仓库。
DOUYIN_COOKIE=

# ============================================
# 数据保留配置
# ============================================
# 数据保留天数（0 表示永久保留）
DATA_RETENTION_DAYS=90

# ============================================
# 调度器配置
# ============================================
# 检查失败房间间隔（秒）
SCHEDULER_RESTART_FAILED_INTERVAL=30

# 保存统计快照间隔（秒）
SCHEDULER_STATS_SNAPSHOT_INTERVAL=60

# 清理旧数据间隔（秒）
SCHEDULER_CLEANUPOldData_INTERVAL=3600

# ============================================
# 日志配置
# ============================================
# 日志级别（DEBUG, INFO, WARNING, ERROR, CRITICAL）
LOG_LEVEL=INFO

# 单个普通日志文件大小上限
LOG_ROTATION=10 MB

# 日志保留时间
LOG_RETENTION=14 days

# 轮转后的日志压缩格式；留空表示不压缩
LOG_COMPRESSION=zip

# 单个错误日志文件大小上限
ERROR_LOG_ROTATION=5 MB

# 日志格式
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# 日志文件路径（相对于项目根目录）
LOG_FILE=logs/app.log
