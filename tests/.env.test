# pytest 用的测试环境覆盖文件。conftest.py 在 import 业务模块前先 load 这份。
# 真正的 AUTH_USERNAME / AUTH_PASSWORD / SECRET_KEY 借项目根 .env（dotenv 默认不覆盖已设变量）。

# 独立测试库（docker/mysql/init/01-create-test-db.sql 创建）；端口 3307 由 docker-compose 暴露
DATABASE_URL=mysql+pymysql://douyin:douyin123@localhost:3307/douyin_live_test?charset=utf8mb4

# 测试不连抖音，不开代理
DOUYIN_COOKIE=
PROXY_ENABLED=False

# 关掉 SQL echo，避免 pytest 输出噪音
SQLALCHEMY_ECHO=False
